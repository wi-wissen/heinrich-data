# Coordinating and subordinating conjunctions (docs/LEXICON_FORMAT_FR.md §6). Own knowledge (clean-room).
car       cconj
comme     sconj
donc      cconj
et        cconj
lorsque   sconj elided=lorsqu'
mais      cconj
ni        cconj
or        cconj
ou        cconj
parce     sconj note=only in parce que
puisque   sconj elided=puisqu'
quand     sconj
que       sconj elided=qu'
quoique   sconj elided=quoiqu'
si        sconj elided=s' note=elides only before il, ils
sinon     cconj
soit      cconj note=soit … soit; soit dit en passant
tandis    sconj note=only in tandis que
