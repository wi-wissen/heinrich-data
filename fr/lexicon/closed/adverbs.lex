# Grammar adverbs: degree, negation, interrogative, deictic (docs/LEXICON_FORMAT_FR.md §6).
# Own knowledge (clean-room). Content adverbs live in adv/<letter>.lex.
assez     adv  type=degree
au-delà   adv  type=place
aucunement adv type=neg
aussi     adv  type=degree
autant    adv  type=degree
beaucoup  adv  type=degree
çà        adv  type=place note=çà et là
combien   adv  type=int|degree
comment   adv  type=int
davantage adv  type=degree
deçà      adv  type=place note=en deçà (de)
encore    adv  type=time|degree
environ   adv  type=degree
guère     adv  type=neg
hier      adv  type=time
ici       adv  type=place
ici-bas   adv  type=place
jamais    adv  type=neg
jusque-là adv  type=time|place
là        adv  type=place
là-bas    adv  type=place
là-dessous adv type=place
là-dessus adv  type=place
là-haut   adv  type=place
lors      adv  type=time note=lors de, dès lors, depuis lors
même      adv  type=degree note=même lui, même pas; the adjective is a separate entry
mieux     adv  type=degree note=comparative of bien
moins     adv  type=degree
ne        adv  type=neg elided=n'
non       adv  type=neg
nullement adv  type=neg
où        adv  type=int note=interrogative où; the relative is a pronoun
pas       adv  type=neg
peu       adv  type=degree
plus      adv  type=degree|neg
point     adv  type=neg style=literary note=ne … point
pourquoi  adv  type=int
près      adv  type=place note=près de, de près, à peu près
presque   adv  type=degree
puis      adv  type=time
quand     adv  type=int note=interrogative quand; the conjunction is a separate entry
quant     adv  type=degree note=only in quant à
quasi     adv  type=degree
si        adv  type=degree note=si grand; the conjunction is a separate entry
sur-le-champ adv type=time
tant      adv  type=degree
tellement adv  type=degree
tout      adv  type=degree note=tout petit, toute petite (agrees before a consonant-initial feminine adjective)
très      adv  type=degree
trop      adv  type=degree
vice-versa adv type=manner note=traditionally also vice versa (two words)
voici     adv  type=deictic
voilà     adv  type=deictic
