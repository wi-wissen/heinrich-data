moi       pron type=prs person=1 number=sg
moi-même  pron type=prs person=1 number=sg
nôtre     pron type=poss person=1 psor=pl forms=nôtre,nôtre,nôtres,nôtres
nous      pron type=prs|rfl person=1 number=pl case=nom|acc|dat
nous-mêmes pron type=prs person=1 number=pl
nul       pron type=neg forms=nul,nulle,-,- note=nul n'est censé ignorer la loi
on        pron type=ind person=3 number=sg case=nom
où        pron type=rel note=relative où (la ville où je vis); interrogative où is an adverb
personne  pron type=neg
plusieurs pron type=ind number=pl
quelqu'un pron type=ind forms=quelqu'un,quelqu'une,quelques-uns,quelques-unes
qui       pron type=rel|int
quiconque pron type=rel|ind
