# Pronouns, including en and y (docs/LEXICON_FORMAT_FR.md §6). Own knowledge (clean-room).
# Sorted by lemma without accents.
aucun     pron type=neg forms=aucun,aucune,-,-
auquel    pron type=rel|int fused=à+lequel forms=auquel,-,auxquels,auxquelles
autre     pron type=ind forms=autre,autre,autres,autres note=l'autre, les autres, d'autres
autrui    pron type=ind
ça        pron type=dem style=colloquial alt=cela
ce        pron type=dem elided=c'
ceci      pron type=dem
cela      pron type=dem
celui     pron type=dem forms=celui,celle,ceux,celles
celui-ci  pron type=dem forms=celui-ci,celle-ci,ceux-ci,celles-ci
celui-là  pron type=dem forms=celui-là,celle-là,ceux-là,celles-là
certain   pron type=ind forms=-,-,certains,certaines
chacun    pron type=tot forms=chacun,chacune,-,-
dont      pron type=rel
duquel    pron type=rel|int fused=de+lequel forms=duquel,-,desquels,desquelles
elle      pron type=prs person=3 number=sg gender=f
elle-même pron type=prs person=3 number=sg gender=f
elles     pron type=prs person=3 number=pl gender=f
elles-mêmes pron type=prs person=3 number=pl gender=f
en        pron type=prs
grand-chose pron type=neg|ind note=pas grand-chose
icelui    pron type=dem forms=icelui,icelle,iceux,icelles style=archaic
eux       pron type=prs person=3 number=pl gender=m
eux-mêmes pron type=prs person=3 number=pl gender=m
