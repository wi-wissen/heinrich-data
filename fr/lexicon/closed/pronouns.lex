ils       pron type=prs person=3 number=pl gender=m case=nom
je        pron type=prs person=1 number=sg case=nom elided=j'
la        pron type=prs person=3 number=sg gender=f case=acc elided=l'
le        pron type=prs person=3 number=sg gender=m case=acc elided=l'
lequel    pron type=rel|int forms=lequel,laquelle,lesquels,lesquelles
les       pron type=prs person=3 number=pl case=acc
leur      pron type=prs person=3 number=pl case=dat
leur      pron type=poss person=3 psor=pl forms=leur,leur,leurs,leurs sense=poss note=le leur, les leurs
lui       pron type=prs person=3 number=sg case=dat note=also the stressed masculine form: avec lui
lui-même  pron type=prs person=3 number=sg gender=m
me        pron type=prs|rfl person=1 number=sg case=acc|dat elided=m'
