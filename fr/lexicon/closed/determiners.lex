# Determiners other than articles (docs/LEXICON_FORMAT_FR.md §6). Own knowledge (clean-room).
aucun     det  type=neg forms=aucun,aucune,aucuns,aucunes note=plural only with plural-only nouns (aucuns frais)
audit     det  type=dem fused=à+ledit forms=audit,-,auxdits,auxdites note=legal style: audit article
ce        det  type=dem forms=ce,cette,ces,ces mv=cet
certain   det  type=ind forms=certain,certaine,certains,certaines note=un certain temps, certains jours
chaque    det  type=tot number=sg
divers    det  type=ind forms=-,-,divers,diverses note=divers auteurs; the adjective is a separate entry
dudit     det  type=dem fused=de+ledit forms=dudit,-,desdits,desdites note=legal style
ledit     det  type=dem forms=ledit,ladite,lesdits,lesdites note=legal style: ledit contrat
leur      det  type=poss person=3 psor=pl forms=leur,leur,leurs,leurs
maint     det  type=ind forms=maint,mainte,maints,maintes style=literary
mon       det  type=poss person=1 psor=sg forms=mon,ma,mes,mes fv=mon
notre     det  type=poss person=1 psor=pl forms=notre,notre,nos,nos
nul       det  type=neg forms=nul,nulle,nuls,nulles
plusieurs det  type=ind number=pl
quel      det  type=int forms=quel,quelle,quels,quelles note=also exclamative: quel temps !
quelque   det  type=ind forms=quelque,quelque,quelques,quelques
son       det  type=poss person=3 psor=sg forms=son,sa,ses,ses fv=son
tel       det type=ind forms=tel,telle,tels,telles note=un tel homme; tel quel
ton       det  type=poss person=2 psor=sg forms=ton,ta,tes,tes fv=ton
tout      det  type=tot forms=tout,toute,tous,toutes
votre     det  type=poss person=2 psor=pl forms=votre,votre,vos,vos
