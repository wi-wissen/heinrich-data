# Prepositions and their contractions (docs/LEXICON_FORMAT_FR.md §6, §6.1). Own knowledge (clean-room).
à         adp
après     adp
au        adp  fused=à+le gender=m number=sg
aux       adp  fused=à+les number=pl
avant     adp
avec      adp
chez      adp
concernant adp note=also the present participle of concerner
contre    adp
dans      adp
de        adp  elided=d'
depuis    adp
derrière  adp
des       adp  fused=de+les number=pl
dès       adp
devant    adp
du        adp  fused=de+le gender=m number=sg
durant    adp
en        adp
entre     adp
envers    adp
ès        adp  fused=en+les number=pl note=docteur ès lettres
excepté   adp
hormis    adp
hors      adp  aspirate
jusque    adp  elided=jusqu'
malgré    adp
moyennant adp
nonobstant adp style=literary
outre     adp
par       adp
parmi     adp
pendant   adp
pour      adp
sans      adp
sauf      adp
selon     adp
sous      adp
sur       adp
vers      adp
via       adp
