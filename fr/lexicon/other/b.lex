# French interjections and other words, letter b (docs/LEXICON_FORMAT_FR.md). Own knowledge (clean-room).
badaboum   intj
bah        intj
bang       intj
basta      intj style=colloquial alt=assez
berk       intj style=colloquial note=also beurk
beurk      intj style=colloquial
bigre      intj style=archaic
bing       intj
bingo      intj
bip        intj
bof        intj
bonjour    intj
bonsoir    intj
boum       intj
bravissimo intj
bravo      intj
brrr       intj
bye        intj style=colloquial alt=au_revoir
bye-bye    intj style=colloquial alt=au_revoir
