# French lexicon, verb, letter f (clean-room, own knowledge)
fabriquer      verb
faciliter      verb
faire          verb class=faire
falloir        verb class=irr impersonal pres=-,-,faut,-,-,- ps=fallus fut=faudrai
               subj=faille impf=fallais pp=fallu pp_inv ppr=- note=impersonal: only il faut …
fatiguer       verb
favoriser      verb
féliciter      verb
fermer         verb
fier           verb pronominal note=se fier à
figurer        verb
financer       verb
finir          verb class=ir
fixer          verb
fonctionner    verb pp_inv
fonder         verb
forcer         verb
former         verb
formuler       verb
fournir        verb class=ir
franchir       verb class=ir
frapper        verb
fuir           verb class=fuir
