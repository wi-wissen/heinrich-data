nevera       noun  g=f
nido         noun  g=m
nieto        noun  g=m f=nieta
nieve        noun  g=f
niño         noun  g=m f=niña
nivel        noun  g=m
nobleza      noun  g=f
noche        noun  g=f
nombramiento noun  g=m
nombre       noun  g=m
norma        noun  g=f
