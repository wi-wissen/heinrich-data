# Auxiliaries and copulas (format §5.8): full tables of ser, estar and haber.
# Written from own knowledge. The full table of ir is in verb/i.lex (verbs must live in verb/).

estar        aux class=irr pres=estoy,estás,está,estamos,estáis,están pret=estuve
             subj=esté,estés,esté,estemos,estéis,estén imp=está pp_inv
haber        aux class=irr pres=he,has,ha|hay,hemos,habéis,han pret=hube fut=habré subj=haya
             imp=he,habed note=hay: the existential present (hay pan); imperative he only in he aquí
ser          aux class=irr pres=soy,eres,es,somos,sois,son impf=era
             pret=fui,fuiste,fue,fuimos,fuisteis,fueron subj=sea imp=sé,sed ger=siendo pp=sido pp_inv
