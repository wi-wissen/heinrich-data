nonagésimo   num  type=ord value=90
centésimo    num  type=ord value=100
milésimo     num  type=ord value=1000
millonésimo  num  type=ord value=1000000

# --- multiplicatives --------------------------------------------------------------------------
doble        num  type=mult value=2
