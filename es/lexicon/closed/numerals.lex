# Numerals (format §6): cardinals written as one word, ordinals, multiplicatives.
# Written from own knowledge. Compound numbers of several words (treinta y uno) are not lemmas.

# --- cardinals --------------------------------------------------------------------------------
cero         num  value=0
uno          num  value=1 f=una apoc=un
dos          num  value=2
tres         num  value=3
cuatro       num  value=4
cinco        num  value=5
seis         num  value=6
siete        num  value=7
ocho         num  value=8
nueve        num  value=9
diez         num  value=10
once         num  value=11
doce         num  value=12
trece        num  value=13
catorce      num  value=14
quince       num  value=15
dieciséis    num  value=16
diecisiete   num  value=17
dieciocho    num  value=18
diecinueve   num  value=19
veinte       num  value=20
veintiuno    num  value=21 f=veintiuna apoc=veintiún
veintidós    num  value=22
veintitrés   num  value=23
veinticuatro num  value=24
veinticinco  num  value=25
veintiséis   num  value=26
veintisiete  num  value=27
veintiocho   num  value=28
veintinueve  num  value=29
treinta      num  value=30
cuarenta     num  value=40
cincuenta    num  value=50
sesenta      num  value=60
setenta      num  value=70
ochenta      num  value=80
noventa      num  value=90
ciento       num  value=100 apoc=cien pl=cientos note=cientos de personas
doscientos   num  value=200 f=doscientas
trescientos  num  value=300 f=trescientas
cuatrocientos num value=400 f=cuatrocientas
quinientos   num  value=500 f=quinientas
seiscientos  num  value=600 f=seiscientas
setecientos  num  value=700 f=setecientas
ochocientos  num  value=800 f=ochocientas
novecientos  num  value=900 f=novecientas
mil          num  value=1000 pl=miles note=miles de personas

# --- ordinals ---------------------------------------------------------------------------------
primero      num  type=ord value=1 apoc=primer
segundo      num  type=ord value=2
tercero      num  type=ord value=3 apoc=tercer
cuarto       num  type=ord value=4
quinto       num  type=ord value=5
sexto        num  type=ord value=6
séptimo      num  type=ord value=7 var=sétimo
octavo       num  type=ord value=8
noveno       num  type=ord value=9
décimo       num  type=ord value=10
undécimo     num  type=ord value=11
duodécimo    num  type=ord value=12
decimotercero num type=ord value=13 apoc=decimotercer
decimocuarto num  type=ord value=14
decimoquinto num  type=ord value=15
decimosexto  num  type=ord value=16
decimoséptimo num type=ord value=17
decimoctavo  num  type=ord value=18
decimonoveno num  type=ord value=19
vigésimo     num  type=ord value=20
trigésimo    num  type=ord value=30
cuadragésimo num  type=ord value=40
quincuagésimo num type=ord value=50
sexagésimo   num  type=ord value=60
septuagésimo num  type=ord value=70
