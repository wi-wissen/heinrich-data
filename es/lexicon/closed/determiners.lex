# Determiners (format §6): demonstratives, possessives, quantifiers, interrogatives, relatives.
# Written from own knowledge.

# --- demonstratives ---------------------------------------------------------------------------
aquel        det  type=dem forms=aquel,aquella,aquellos,aquellas
ese          det  type=dem forms=ese,esa,esos,esas
este         det  type=dem forms=este,esta,estos,estas
tal          det  type=dem forms=tal,tal,tales,tales note=tal cosa, tales casos

# --- possessives ------------------------------------------------------------------------------
mi           det  type=poss person=1 psor=sg forms=mi,mi,mis,mis
tu           det  type=poss person=2 psor=sg forms=tu,tu,tus,tus
su           det  type=poss person=3 forms=su,su,sus,sus
nuestro      det  type=poss person=1 psor=pl forms=nuestro,nuestra,nuestros,nuestras
vuestro      det  type=poss person=2 psor=pl forms=vuestro,vuestra,vuestros,vuestras
mío          det  type=poss person=1 psor=sg forms=mío,mía,míos,mías note=after the noun: un amigo mío
tuyo         det  type=poss person=2 psor=sg forms=tuyo,tuya,tuyos,tuyas note=after the noun: un amigo tuyo
suyo         det  type=poss person=3 forms=suyo,suya,suyos,suyas note=after the noun: un amigo suyo

# --- interrogatives, exclamatives, relatives --------------------------------------------------
cuánto       det  type=int forms=cuánto,cuánta,cuántos,cuántas
cuanto       det  type=rel forms=cuanto,cuanta,cuantos,cuantas note=cuantas veces quieras
cuyo         det  type=rel forms=cuyo,cuya,cuyos,cuyas
qué          det  type=int note=qué libro, qué día

# --- quantifiers and indefinites --------------------------------------------------------------
alguno       det  type=ind forms=alguno,alguna,algunos,algunas apoc=algún
ambos        det  type=tot forms=-,-,ambos,ambas
bastante     det  type=ind forms=bastante,bastante,bastantes,bastantes
cada         det  type=tot note=invariable: cada día, cada semana
cierto       det  type=ind forms=cierto,cierta,ciertos,ciertas note=before the noun: cierto día
cualquiera   det  type=ind forms=cualquiera,cualquiera,cualesquiera,cualesquiera apoc=cualquier
demás        det  type=ind note=invariable: los demás días, las demás personas
demasiado    det  type=ind forms=demasiado,demasiada,demasiados,demasiadas
más          det  type=ind note=invariable: más tiempo, más personas
menos        det  type=ind note=invariable: menos tiempo, menos personas
mucho        det  type=ind forms=mucho,mucha,muchos,muchas
ninguno      det  type=neg forms=ninguno,ninguna,ningunos,ningunas apoc=ningún
otro         det  type=ind forms=otro,otra,otros,otras
poco         det  type=ind forms=poco,poca,pocos,pocas
sendos       det  type=ind forms=-,-,sendos,sendas note=one each: sendos regalos
tanto        det  type=ind forms=tanto,tanta,tantos,tantas
todo         det  type=tot forms=todo,toda,todos,todas
varios       det  type=ind forms=-,-,varios,varias
