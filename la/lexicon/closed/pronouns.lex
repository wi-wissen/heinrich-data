# Latin pronouns and possessive determiners (closed class).
# Personal, reflexive, demonstrative, emphatic, relative, interrogative, indefinite and negative
# pronouns, the pronominal adjectives used as pronouns, correlatives and the possessives.
# Written from own knowledge (AUTHORING.md §1); format: Heinrich docs/LEXICON_FORMAT_LA.md §6.
aliquī pron class=qui type=ind nom_sg_f=aliqua nom_pl_n=aliqua
aliquis pron class=quis
aliquot pron type=ind
alius, alia, aliud pron type=ind
alter, altera, alterum pron type=ind gen_ius
ecquis pron class=quis type=int
ego pron class=ego
hic pron class=hic
īdem pron class=idem
ille, illa, illud pron type=dem
ipse, ipsa, ipsum pron type=emp gen_ius
is pron class=is
iste, ista, istud pron type=dem
meus, mea, meum det type=poss person=1 voc_sg_m=mī
nēmō, nēminis pron c type=neg gen_sg=nūllīus abl_sg=nūllō
neuter, neutra, neutrum pron type=neg gen_ius
nihil|nīl[poetic] pron type=neg
nōnnūllus, nōnnūlla, nōnnūllum pron type=ind gen_ius
nōs pron class=nos
noster, nostra, nostrum det type=poss person=1
nūllus, nūlla, nūllum pron type=neg gen_ius
quālis, quāle pron type=int
quantus, quanta, quantum pron type=int
quī pron class=qui
quīcumque pron class=qui
quīdam pron class=qui
quīlibet pron class=qui
quis pron class=quis
quispiam pron class=quis
quisquam pron class=quis nom_sg_f=quisquam acc_sg_f=quemquam abl_sg_f=quōquam note=one form for both genders
quisque pron class=quis
quisquis pron class=quis
quīvīs pron class=qui
quot pron type=int
suī pron class=sui
suus, sua, suum det type=poss person=3
tālis, tāle pron type=dem
tantus, tanta, tantum pron type=dem
tot pron type=dem
totidem pron type=dem
tū pron class=tu
tuus, tua, tuum det type=poss person=2
ūllus, ūlla, ūllum pron type=ind gen_ius
uter, utra, utrum pron type=int gen_ius
uterque, utraque, utrumque pron type=tot gen_ius
vester, vestra, vestrum det type=poss person=2 var=voster[archaic]
vōs pron class=vos
