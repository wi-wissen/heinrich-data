# Latin particles (closed class): negation, question, emphasis, wish.
# Written from own knowledge (AUTHORING.md §1); format: Heinrich docs/LEXICON_FORMAT_LA.md §7.
-ne part type=int
an part type=int
haud part type=neg
nē part type=neg
nōn part type=neg
nōnne part type=int
num part type=int
quidem part type=emp
utinam part type=opt
utrum part type=int
