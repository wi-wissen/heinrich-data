# Latin prepositions and postpositions (closed class) with the case they govern.
# Written from own knowledge (AUTHORING.md §1); format: Heinrich docs/LEXICON_FORMAT_LA.md §7.
ā|ab|abs adp case=abl
absque adp case=abl
ad adp case=acc
adversus|adversum adp case=acc
ante adp case=acc
apud adp case=acc
causā adp case=gen
circā adp case=acc
circiter adp case=acc
circum adp case=acc
cis adp case=acc
citrā adp case=acc
clam adp case=abl
contrā adp case=acc
cōram adp case=abl
cum adp case=abl
dē adp case=abl
ē|ex adp case=abl
ergā adp case=acc
extrā adp case=acc
grātiā adp case=gen
in adp case=acc|abl
īnfrā adp case=acc
inter adp case=acc
intrā adp case=acc
iūxtā adp case=acc
ob adp case=acc
palam adp case=abl
penes adp case=acc
per adp case=acc
post adp case=acc
prae adp case=abl
praeter adp case=acc
prō adp case=abl
prope adp case=acc
propter adp case=acc
secundum adp case=acc
sine adp case=abl
sub adp case=acc|abl
subter adp case=acc|abl
super adp case=acc|abl
suprā adp case=acc
tenus adp case=abl
trāns adp case=acc
ultrā adp case=acc
versus adp case=acc
