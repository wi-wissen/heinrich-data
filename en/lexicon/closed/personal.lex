# Personal pronouns: the lemma is the subject form (Case=Nom), `acc=` the object form.
I        pron type=prs person=1 number=sg acc=me
you      pron type=prs person=2 number=sg|pl acc=you
he       pron type=prs person=3 number=sg gender=m acc=him
she      pron type=prs person=3 number=sg gender=f acc=her
it       pron type=prs person=3 number=sg gender=n acc=it
we       pron type=prs person=1 number=pl acc=us
they     pron type=prs person=3 number=pl acc=them note=also singular they
thou     pron type=prs person=2 number=sg acc=thee style=archaic
ye       pron type=prs person=2 number=pl acc=you style=archaic
one      pron type=ind person=3 pl=ones note=generic one; the ones on the left
