# Quantifiers and indefinite, negative and total determiners and pronouns.
# Determiners
all        det  type=tot
another    det  type=ind number=sg
any        det  type=ind
both       det  type=tot number=pl
each       det  type=tot number=sg
either     det  type=ind number=sg
enough     det  type=ind
every      det  type=tot number=sg
few        det  type=ind number=pl
fewer      det  type=ind number=pl
fewest     det  type=ind number=pl
less       det  type=ind number=sg
least      det  type=ind number=sg
little     det  type=ind number=sg note=little time; the adjective is a separate entry
many       det  type=ind number=pl
more       det  type=ind
most       det  type=ind
much       det  type=ind number=sg
neither    det  type=neg number=sg
no         det  type=neg
other      det  type=ind
several    det  type=ind number=pl
some       det  type=ind
# Pronouns
all        pron type=tot
another    pron type=ind number=sg
any        pron type=ind
anybody    pron type=ind number=sg
anyone     pron type=ind number=sg
anything   pron type=ind number=sg
both       pron type=tot number=pl
each       pron type=tot number=sg
either     pron type=ind number=sg
enough     pron type=ind
everybody  pron type=tot number=sg
everyone   pron type=tot number=sg
everything pron type=tot number=sg
few        pron type=ind number=pl
fewer      pron type=ind number=pl
less       pron type=ind number=sg
little     pron type=ind number=sg
many       pron type=ind number=pl
more       pron type=ind
most       pron type=ind
much       pron type=ind number=sg
neither    pron type=neg number=sg
nobody     pron type=neg number=sg
none       pron type=neg
nothing    pron type=neg number=sg
other      pron type=ind pl=others
several    pron type=ind number=pl
some       pron type=ind
somebody   pron type=ind number=sg
someone    pron type=ind number=sg
something  pron type=ind number=sg
