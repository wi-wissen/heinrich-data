# Interrogative and relative pronouns and determiners.
who        pron type=int|rel acc=whom
whose      det  type=int|rel
whose      pron type=int|rel
which      det  type=int|rel
which      pron type=int|rel
what       det  type=int
what       pron type=int|rel note=free relative: what you said
that       pron type=rel sense=rel note=the book that I read
whoever    pron type=rel|ind acc=whomever
whatever   det  type=rel|ind
whatever   pron type=rel|ind
whichever  det  type=rel|ind
whichever  pron type=rel|ind
