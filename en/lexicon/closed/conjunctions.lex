# Coordinating and subordinating conjunctions. `type=` as in the German format (meaning).
and          cconj type=copulative
but          cconj type=adversative
for          cconj type=causal style=rare note=he left, for it was late
nor          cconj type=copulative
or           cconj type=disjunctive
so           cconj type=consecutive
yet          cconj type=adversative
after        sconj type=temporal
although     sconj type=concessive
as           sconj type=causal|temporal|comparative
because      sconj type=causal
before       sconj type=temporal
if           sconj type=conditional|interrogative
lest         sconj type=final style=rare
once         sconj type=temporal
since        sconj type=causal|temporal
so           sconj type=final|consecutive note=so that
than         sconj type=comparative
that         sconj type=content
though       sconj type=concessive
till         sconj type=temporal
unless       sconj type=conditional
until        sconj type=temporal
when         sconj type=temporal
whenever     sconj type=temporal
where        sconj type=place
whereas      sconj type=adversative
wherever     sconj type=place
whether      sconj type=interrogative
while        sconj type=temporal|adversative
whilst       sconj type=temporal|adversative region=GB
