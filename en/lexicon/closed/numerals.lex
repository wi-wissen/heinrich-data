millionth    num type=ord value=1000000
billionth    num type=ord value=1000000000
last         num type=ord note=the last day
half         num type=frac value=1/2 pl=halves
once         num type=mult value=1 note=also a conjunction
twice        num type=mult value=2
thrice       num type=mult value=3 style=archaic
