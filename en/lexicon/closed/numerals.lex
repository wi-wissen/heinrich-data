twelfth      num type=ord value=12
thirteenth   num type=ord value=13
fourteenth   num type=ord value=14
fifteenth    num type=ord value=15
sixteenth    num type=ord value=16
seventeenth  num type=ord value=17
eighteenth   num type=ord value=18
nineteenth   num type=ord value=19
twentieth    num type=ord value=20
thirtieth    num type=ord value=30
fortieth     num type=ord value=40
fiftieth     num type=ord value=50
sixtieth     num type=ord value=60
seventieth   num type=ord value=70
eightieth    num type=ord value=80
