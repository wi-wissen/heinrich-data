# Numerals: cardinals (with the plurals used as nouns: hundreds of people), ordinals,
# multiplicatives. Compound numbers are hyphenated and need no entry (twenty-one, ninety-ninth).
zero         num value=0 pl=zeros|zeroes
nought       num value=0 region=GB
one          num value=1
two          num value=2
three        num value=3
four         num value=4
five         num value=5
six          num value=6
seven        num value=7
eight        num value=8
nine         num value=9
ten          num value=10 pl=tens
eleven       num value=11
twelve       num value=12
thirteen     num value=13
fourteen     num value=14
fifteen      num value=15
sixteen      num value=16
seventeen    num value=17
eighteen     num value=18
nineteen     num value=19
twenty       num value=20 pl=twenties
thirty       num value=30 pl=thirties
forty        num value=40 pl=forties
fifty        num value=50 pl=fifties
sixty        num value=60 pl=sixties
seventy      num value=70 pl=seventies
eighty       num value=80 pl=eighties
ninety       num value=90 pl=nineties
hundred      num value=100 pl=hundreds
thousand     num value=1000 pl=thousands
million      num value=1000000 pl=millions
billion      num value=1000000000 pl=billions
trillion     num value=1000000000000 pl=trillions
dozen        num value=12 pl=dozens
first        num type=ord value=1
second       num type=ord value=2
third        num type=ord value=3
fourth       num type=ord value=4
fifth        num type=ord value=5
sixth        num type=ord value=6
seventh      num type=ord value=7
eighth       num type=ord value=8
ninth        num type=ord value=9
tenth        num type=ord value=10
