# Possessives: determiners (my book) and independent pronouns (the book is mine).
my       det  type=poss person=1 number=sg
your     det  type=poss person=2
his      det  type=poss person=3 number=sg gender=m
her      det  type=poss person=3 number=sg gender=f
its      det  type=poss person=3 number=sg gender=n
our      det  type=poss person=1 number=pl
their    det  type=poss person=3 number=pl
thy      det  type=poss person=2 number=sg style=archaic
mine     pron type=poss person=1 number=sg
yours    pron type=poss person=2
his      pron type=poss person=3 number=sg gender=m
hers     pron type=poss person=3 number=sg gender=f
ours     pron type=poss person=1 number=pl
theirs   pron type=poss person=3 number=pl
thine    pron type=poss person=2 number=sg style=archaic
