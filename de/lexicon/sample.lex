# Heinrich German lexicon – M1a sample (format: Heinrich docs/LEXICON_FORMAT.md).
# Written clean-room from general knowledge of German grammar; one entry per line,
# indented lines continue the entry above.

# ---------------------------------------------------------------- nouns
Haus         noun g=n gen=Hauses pl=Häuser
Hand         noun g=f gen=Hand pl=Hände
Frau         noun g=f gen=Frau pl=Frauen
Tag          noun g=m gen=Tages|Tags pl=Tage
Kind         noun g=n gen=Kindes|Kinds pl=Kinder
Lehrer       noun g=m gen=Lehrers pl=Lehrer
Auto         noun g=n gen=Autos pl=Autos
Junge        noun g=m gen=Jungen pl=Jungen note=weak masculine (n-declension)
Herr         noun g=m gen=Herrn pl=Herren
Student      noun g=m gen=Studenten pl=Studenten
Name         noun g=m gen=Namens pl=Namen
Herz         noun g=n gen=Herzens pl=Herzen
Museum       noun g=n gen=Museums pl=Museen
Thema        noun g=n gen=Themas pl=Themen
Firma        noun g=f gen=Firma pl=Firmen
Komma        noun g=n gen=Kommas pl=Kommas|Kommata
Pizza        noun g=f gen=Pizza pl=Pizzas|Pizzen
Gehalt       noun g=n gen=Gehalts|Gehaltes pl=Gehälter sense=salary note=das Gehalt: pay
Gehalt       noun g=m gen=Gehalts|Gehaltes pl=Gehalte sense=content note=der Gehalt: proportion, substance
Teil         noun g=m gen=Teils|Teiles pl=Teile sense=portion note=der Teil: part of a whole
Teil         noun g=n gen=Teils|Teiles pl=Teile sense=piece note=das Teil: a separate piece
Joghurt      noun g=m|n gen=Joghurts pl=Joghurts note=both genders, same meaning
Mutter       noun g=f gen=Mutter pl=Mütter sense=parent
Mutter       noun g=f gen=Mutter pl=Muttern sense=nut note=Schraubenmutter
Milch        noun g=f gen=Milch pl=- note=plural Milche only in technical use
Leute        noun g=pl
Eltern       noun g=pl
Angestellte  noun g=m|f decl=adj
Paradeiser   noun g=m gen=Paradeisers pl=Paradeiser region=AT note=tomato

# ---------------------------------------------------------------- verbs
machen       verb class=weak pp=gemacht perf=haben
arbeiten     verb class=weak pp=gearbeitet perf=haben
reisen       verb class=weak pp=gereist perf=sein
tanzen       verb class=weak pp=getanzt perf=haben
atmen        verb class=weak pp=geatmet perf=haben
sammeln      verb class=weak pp=gesammelt perf=haben
wandern      verb class=weak pp=gewandert perf=sein
studieren    verb class=weak pp=studiert perf=haben
freuen       verb class=weak pp=gefreut perf=haben refl=acc
abholen      verb class=weak sep=ab pp=abgeholt perf=haben
sprechen     verb class=strong 3sg=spricht past=sprach pp=gesprochen subj2=spräche perf=haben
geben        verb class=strong 3sg=gibt past=gab pp=gegeben subj2=gäbe perf=haben
lesen        verb class=strong 3sg=liest past=las pp=gelesen subj2=läse perf=haben
helfen       verb class=strong 3sg=hilft past=half pp=geholfen subj2=hülfe|hälfe[rare] perf=haben
fahren       verb class=strong 3sg=fährt past=fuhr pp=gefahren subj2=führe perf=haben|sein
laufen       verb class=strong 3sg=läuft past=lief pp=gelaufen subj2=liefe perf=sein
halten       verb class=strong 3sg=hält past=hielt pp=gehalten subj2=hielte perf=haben
finden       verb class=strong 3sg=findet past=fand pp=gefunden subj2=fände perf=haben
gehen        verb class=strong 3sg=geht past=ging pp=gegangen subj2=ginge perf=sein
kommen       verb class=strong 3sg=kommt past=kam pp=gekommen subj2=käme perf=sein
ankommen     verb class=strong sep=an 3sg=ankommt past=ankam pp=angekommen subj2=ankäme perf=sein
fernsehen    verb class=strong sep=fern 3sg=fernsieht past=fernsah pp=ferngesehen subj2=fernsähe perf=haben
verstehen    verb class=strong 3sg=versteht past=verstand pp=verstanden subj2=verstände|verstünde perf=haben
umfahren     verb class=strong sep=um 3sg=umfährt past=umfuhr pp=umgefahren subj2=umführe perf=haben
             sense=knock_over note=jemanden umfahren: knock down (separable, stress on um)
umfahren     verb class=strong 3sg=umfährt past=umfuhr pp=umfahren subj2=umführe perf=haben
             sense=drive_around note=ein Hindernis umfahren: go around (inseparable, stress on fahren)
bringen      verb class=mixed 3sg=bringt past=brachte pp=gebracht subj2=brächte perf=haben
denken       verb class=mixed 3sg=denkt past=dachte pp=gedacht subj2=dächte perf=haben
tun          verb class=strong pres=tue,tust,tut,tun,tut,tun past=tat pp=getan subj2=täte perf=haben
wissen       verb class=modal 3sg=weiß past=wusste pp=gewusst subj2=wüsste imp=wisse,wisst perf=haben
können       aux class=modal 3sg=kann past=konnte pp=gekonnt subj2=könnte perf=haben
mögen        aux class=modal 3sg=mag past=mochte pp=gemocht subj2=möchte perf=haben
müssen       aux class=modal 3sg=muss past=musste pp=gemusst subj2=müsste perf=haben
haben        aux class=mixed pres=habe,hast,hat,haben,habt,haben past=hatte pp=gehabt subj2=hätte perf=haben
werden       aux class=strong pres=werde,wirst,wird,werden,werdet,werden
             past=wurde|ward[archaic],wurdest|wardst[archaic],wurde|ward[archaic],wurden,wurdet,wurden
             subj2=würde imp=werde,werdet pp=geworden|worden perf=sein
             note=pp worden only in the passive (ist gelobt worden)
sein         aux class=irregular perf=sein pp=gewesen
             pres=bin,bist,ist,sind,seid,sind
             past=war,warst,war,waren,wart,waren
             subj1=sei,seist|seiest,sei,seien,seiet,seien
             subj2=wäre,wärst|wärest,wäre,wären,wärt|wäret,wären
             imp=sei,seid

# ---------------------------------------------------------------- adjectives
gut          adj cmp=besser sup=besten
groß         adj cmp=größer sup=größten
klein        adj cmp=kleiner sup=kleinsten
alt          adj cmp=älter sup=ältesten
nah          adj cmp=näher sup=nächsten
hoch         adj attr=hohe cmp=höher sup=höchsten
dunkel       adj cmp=dunkler sup=dunkelsten
teuer        adj cmp=teurer sup=teuersten
leise        adj cmp=leiser sup=leisesten
viel         adj cmp=mehr sup=meisten cmp_indecl
lila         adj indecl
rosa         adj indecl
deutsch      adj

# ---------------------------------------------------------------- uninflected
gern         adv cmp=lieber sup=liebsten
oft          adv cmp=öfter sup=öftesten
leider       adv
