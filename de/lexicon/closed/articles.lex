# Articles (det, type=art). Written clean-room by hand.
# Tables are Nom,Gen,Dat,Acc; m/f/n = singular, pl = plural.
# adj= gives the declension of a following adjective: der gute (weak), ein guter (mixed).
# The indefinite article has no plural; its negative counterpart kein is in indefinite.lex.

der          det type=art definite=def adj=weak
             m=der,des,dem,den
             f=die,der,der,die
             n=das,des,dem,das
             pl=die,der,den,die
ein          det type=art definite=ind decl=ein pl=-
             note=ein, eines, einem, einen; eine, einer; colloquial 'n/'ne is not written as a separate form
