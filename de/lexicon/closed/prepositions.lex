# Adpositions (adp) with the case(s) they govern. Written clean-room by hand.
# case=      governed case(s); dat|acc = two-way preposition (Wechselpräposition: dative for
#            location, accusative for direction); a tagged case is non-standard
#            (wegen dem Regen: [colloquial]).
# place=     pre (default, before the noun phrase), post (der Kinder wegen), circum (um … willen).
# fused=     contraction of a preposition and a definite article (zum = zu+dem).
# pair=      the second part of a circumposition.
# Prepositions used as verb particles (an, auf, aus …) are generated by the verb entries.

# ---------------------------------------------------------------- accusative
bis          adp case=acc note=mostly with another preposition (bis zum Abend) or without article (bis Montag)
durch        adp case=acc
entlang      adp case=acc|gen|dat place=post|pre note=den Fluss entlang (post, acc); entlang des Flusses / dem Fluss (pre, gen or dat)
für          adp case=acc
gegen        adp case=acc
gen          adp case=acc style=archaic note=gen Himmel
je           adp case=acc note=per (je Person); also an adverb and a conjunction (je … desto)
kontra       adp case=acc
ohne         adp case=acc
per          adp case=acc note=usually without article (per Post)
pro          adp case=acc note=usually without article (pro Kopf)
um           adp case=acc pair=willen note=um … willen (with genitive) is a circumposition
via          adp case=acc
wider        adp case=acc note=against (wider Willen); not wieder (again)
hindurch     adp case=acc place=post note=die ganze Nacht hindurch

# ---------------------------------------------------------------- dative
ab           adp case=dat|acc note=ab dem ersten Mai / ab ersten Mai
aus          adp case=dat
außer        adp case=dat|gen[archaic] note=außer Landes (fixed genitive)
bei          adp case=dat
binnen       adp case=dat|gen
dank         adp case=dat|gen
entgegen     adp case=dat place=pre|post
entsprechend adp case=dat place=pre|post
gegenüber    adp case=dat place=post|pre note=dem Bahnhof gegenüber / gegenüber dem Bahnhof
gemäß        adp case=dat place=pre|post
mit          adp case=dat
mitsamt      adp case=dat
nach         adp case=dat place=pre|post note=meiner Meinung nach (post)
nächst       adp case=dat style=archaic
nahe         adp case=dat
nebst        adp case=dat
samt         adp case=dat
seit         adp case=dat
von          adp case=dat
zu           adp case=dat
zufolge      adp case=dat|gen place=post|pre note=dem Bericht zufolge (post, dat); zufolge des Berichts (pre, gen)
zuliebe      adp case=dat place=post
zuwider      adp case=dat place=post

# ---------------------------------------------------------------- two-way (dative or accusative)
an           adp case=dat|acc
auf          adp case=dat|acc
hinter       adp case=dat|acc
in           adp case=dat|acc
neben        adp case=dat|acc
über         adp case=dat|acc
unter        adp case=dat|acc
vor          adp case=dat|acc
zwischen     adp case=dat|acc

# ---------------------------------------------------------------- genitive
# A colloquial dative is tagged where it is common in speech; it must not be suggested in
# school texts.
abseits      adp case=gen
abzüglich    adp case=gen
angesichts   adp case=gen
anhand       adp case=gen
anlässlich   adp case=gen
anstatt      adp case=gen|dat[colloquial]
anstelle     adp case=gen note=also an Stelle
aufgrund     adp case=gen note=also auf Grund
aufseiten    adp case=gen note=also auf Seiten
ausschließlich adp case=gen
außerhalb    adp case=gen
beiderseits  adp case=gen
betreffs     adp case=gen
bezüglich    adp case=gen
diesseits    adp case=gen
eingangs     adp case=gen
einschließlich adp case=gen
exklusive    adp case=gen
fernab       adp case=gen
halber       adp case=gen place=post note=der Ordnung halber
hinsichtlich adp case=gen
infolge      adp case=gen
inklusive    adp case=gen
inmitten     adp case=gen
innerhalb    adp case=gen
jenseits     adp case=gen
kraft        adp case=gen
längs        adp case=gen|dat
laut         adp case=gen|dat note=laut Bericht / laut des Berichts
mangels      adp case=gen
mithilfe     adp case=gen note=also mit Hilfe
mittels      adp case=gen
namens       adp case=gen
oberhalb     adp case=gen
ob           adp case=gen style=archaic note=ob des Lärms (because of); the conjunction ob is in conjunctions.lex
seitens      adp case=gen
statt        adp case=gen|dat[colloquial]
trotz        adp case=gen|dat[colloquial]
unbeschadet  adp case=gen
ungeachtet   adp case=gen place=pre|post
unterhalb    adp case=gen
unweit       adp case=gen
vonseiten    adp case=gen note=also von Seiten
vorbehaltlich adp case=gen
während      adp case=gen|dat[colloquial]
wegen        adp case=gen|dat[colloquial] place=pre|post note=der Kinder wegen (post)
willen       adp case=gen place=circum note=um des Friedens willen
zeit         adp case=gen note=zeit seines Lebens
zugunsten    adp case=gen place=pre|post
zulasten     adp case=gen
zuungunsten  adp case=gen
zuzüglich    adp case=gen
zwecks       adp case=gen

# ---------------------------------------------------------------- contractions (preposition + definite article)
am           adp case=dat fused=an+dem note=also in the superlative (am besten)
ans          adp case=acc fused=an+das
aufs         adp case=acc fused=auf+das
beim         adp case=dat fused=bei+dem
durchs       adp case=acc fused=durch+das
fürs         adp case=acc fused=für+das
hinterm      adp case=dat fused=hinter+dem style=colloquial
hinters      adp case=acc fused=hinter+das style=colloquial
im           adp case=dat fused=in+dem
ins          adp case=acc fused=in+das
überm        adp case=dat fused=über+dem style=colloquial
übers        adp case=acc fused=über+das
ums          adp case=acc fused=um+das
unterm       adp case=dat fused=unter+dem style=colloquial
unters       adp case=acc fused=unter+das style=colloquial
vom          adp case=dat fused=von+dem
vorm         adp case=dat fused=vor+dem style=colloquial
vors         adp case=acc fused=vor+das style=colloquial
zum          adp case=dat fused=zu+dem
zur          adp case=dat fused=zu+der
