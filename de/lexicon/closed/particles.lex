# Particles (part). Written clean-room by hand.
# type=  neg (nicht), zu (infinitive marker), degree (zu groß, gar nicht), answer (ja, nein,
#        doch), modal (unstressed modal particles: das ist ja schön, komm doch mit), focus.
# Words that are also conjunctions or adverbs have separate entries there.

nicht        part type=neg
zu           part type=zu|degree note=infinitive marker (zu gehen) and degree (zu groß); the preposition is in prepositions.lex
gar          part type=degree note=gar nicht, gar kein
ja           part type=answer|modal
nein         part type=answer
doch         part type=answer|modal
aber         part type=modal note=das ist aber schön
denn         part type=modal note=was ist denn los?
eben         part type=modal note=das ist eben so; also an adverb of time and an adjective
eh           part type=modal style=colloquial
eigentlich   part type=modal note=also an adjective
etwa         part type=modal note=ist das etwa wahr?
halt         part type=modal note=regional and colloquial; also the imperative of halten
mal          part type=modal note=komm mal her
ruhig        part type=modal note=du kannst ruhig kommen; also an adjective
schon        part type=modal note=das wird schon gehen
bloß         part type=focus|modal note=also an adjective
wohl         part type=modal note=er ist wohl krank
