# Demonstrative determiners and pronouns. Written clean-room by hand.
# der/die/das as a demonstrative pronoun has the long forms dessen, deren, denen;
# derer is the genitive used before a relative clause (das Andenken derer, die …).

der          pron type=dem sense=dem
             m=der,dessen|des[archaic],dem,den
             f=die,deren|derer,der,die
             n=das,dessen|des[archaic],dem,das
             pl=die,deren|derer,denen,die
dieser       det type=dem decl=dieser n=dieses|dies[rare],dieses,diesem,dieses|dies[rare]
dieser       pron type=dem decl=dieser n=dieses|dies,dieses,diesem,dieses|dies
             note=dies is common as a pronoun (dies ist richtig)
jener        det type=dem decl=dieser
jener        pron type=dem decl=dieser
derjenige    det type=dem adj=weak
             m=derjenige,desjenigen,demjenigen,denjenigen
             f=diejenige,derjenigen,derjenigen,diejenige
             n=dasjenige,desjenigen,demjenigen,dasjenige
             pl=diejenigen,derjenigen,denjenigen,diejenigen
derjenige    pron type=dem
             m=derjenige,desjenigen,demjenigen,denjenigen
             f=diejenige,derjenigen,derjenigen,diejenige
             n=dasjenige,desjenigen,demjenigen,dasjenige
             pl=diejenigen,derjenigen,denjenigen,diejenigen
derselbe     det type=dem adj=weak
             m=derselbe,desselben,demselben,denselben
             f=dieselbe,derselben,derselben,dieselbe
             n=dasselbe,desselben,demselben,dasselbe
             pl=dieselben,derselben,denselben,dieselben
derselbe     pron type=dem
             m=derselbe,desselben,demselben,denselben
             f=dieselbe,derselben,derselben,dieselbe
             n=dasselbe,desselben,demselben,dasselbe
             pl=dieselben,derselben,denselben,dieselben
selbe        det type=dem adj=weak note=only after an article or a fused preposition (am selben Tag, im selben Jahr)
             m=selbe,selben,selben,selben
             f=selbe,selben,selben,selbe
             n=selbe,selben,selben,selbe
             pl=selben,selben,selben,selben
solcher      det type=dem decl=dieser adj=weak|strong
             m=solcher,solches|solchen,solchem,solchen
             n=solches,solches|solchen,solchem,solches
             note=after solche (plural) both weak and strong adjectives occur (solche guten/gute Ideen)
solcher      pron type=dem decl=dieser
solch        det type=dem note=uninflected before ein or an adjective (solch ein Glück, solch schönes Wetter)
